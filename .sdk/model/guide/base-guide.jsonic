# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 2

  entity: document: {
    path: "/documents": {
      op: list: method: *GET
    }
    path: "/documents/{document_number}": {
      rename: param: "document_number": *"id"
      op: load: method: *GET
    }
  }

}