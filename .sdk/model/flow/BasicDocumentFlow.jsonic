# BasicDocumentFlow

main: kit: flow: BasicDocumentFlow:
{
  entity: "document",
  kind: "basic",
  name: "BasicDocumentFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "document_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "document_ref01",
        srcdatavar: "document_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "document01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-document_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDocumentFlow"
}