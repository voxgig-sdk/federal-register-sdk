# Entity: document

main: kit: entity: document: {

  alias: field: {}

  fields: [
    {
      name: "abstract"
      req: false
      short: "Brief summary of the document"
      type: "`$STRING`"
    }
    {
      name: "action"
      req: false
      short: "Action being taken by the document"
      type: "`$STRING`"
    }
    {
      name: "agencies"
      req: false
      short: "Agencies associated with the document"
      type: "`$ARRAY`"
    }
    {
      name: "body_html_url"
      req: false
      short: "URL to the full HTML body of the document"
      type: "`$STRING`"
    }
    {
      name: "citation"
      req: false
      short: "Official citation for the document"
      type: "`$STRING`"
    }
    {
      name: "document_number"
      req: false
      short: "Unique identifier for the document"
      type: "`$STRING`"
    }
    {
      name: "full_text_xml_url"
      req: false
      short: "URL to the full text XML of the document"
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: false
      short: "URL to the document on FederalRegister.gov"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "pdf_url"
      req: false
      short: "URL to the PDF version of the document"
      type: "`$STRING`"
    }
    {
      name: "publication_date"
      req: false
      short: "Date the document was published"
      type: "`$STRING`"
    }
    {
      name: "signing_date"
      req: false
      short: "Date the document was signed"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the document"
      type: "`$STRING`"
    }
    {
      name: "topics"
      req: false
      short: "Topics associated with the document"
      type: "`$ARRAY`"
    }
    {
      name: "type"
      req: false
      short: "Type of document"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "document"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: [
                  "environmental-protection-agency"
                ]
                kind: "query"
                name: "conditions_agency"
                orig: "conditions_agency"
                reqd: false
                type: "`$ARRAY`"
              }
              {
                example: "2021-01-01"
                kind: "query"
                name: "conditions_publication_date_gte"
                orig: "conditions_publication_date_gte"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2021-12-31"
                kind: "query"
                name: "conditions_publication_date_lte"
                orig: "conditions_publication_date_lte"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 2021
                kind: "query"
                name: "conditions_publication_date_year"
                orig: "conditions_publication_date_year"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "climate change"
                kind: "query"
                name: "conditions_term"
                orig: "conditions_term"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: [
                  "RULE"
                ]
                kind: "query"
                name: "conditions_type"
                orig: "conditions_type"
                reqd: false
                type: "`$ARRAY`"
              }
              {
                example: [
                  "title"
                  "publication_date"
                  "document_number"
                ]
                kind: "query"
                name: "field"
                orig: "field"
                reqd: false
                type: "`$ARRAY`"
              }
              {
                example: "json"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "newest"
                kind: "query"
                name: "order"
                orig: "order"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 20
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/documents"
          parts: [
            "documents"
          ]
          select: {
            exist: [
              "conditions_agency"
              "conditions_publication_date_gte"
              "conditions_publication_date_lte"
              "conditions_publication_date_year"
              "conditions_term"
              "conditions_type"
              "field"
              "format"
              "order"
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "2021-12345"
                kind: "param"
                name: "id"
                orig: "document_number"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "title,publication_date,agencies"
                kind: "query"
                name: "field"
                orig: "field"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/documents/{document_number}"
          parts: [
            "documents"
            "{id}"
          ]
          rename: {
            param: {
              document_number: "id"
            }
          }
          select: {
            exist: [
              "field"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
